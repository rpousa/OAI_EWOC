ARG BASE_IMAGE=ubuntu:jammy

FROM ran-build:latest AS ran-build-source

FROM $BASE_IMAGE AS oai-flexric-base
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Paris

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get upgrade --yes && \
    DEBIAN_FRONTEND=noninteractive apt-get install --yes \
       build-essential \
       libsctp-dev \
       git \
       wget \
       tar \
       m4 \
       automake \
       libtool \
       python3 \
       cmake \
       cmake-curses-gui \
       bison \
       flex \
       gdb \
       libpcre2-dev \
       python3-dev \
       python3-pip \
       gcc-12 \
       g++-12 \
       mold \
       ninja-build && \
    apt-get clean

RUN git clone https://github.com/swig/swig.git && \
    cd swig && \
    git checkout release-4.1 && \
    ./autogen.sh && \
    ./configure --prefix=/usr/ && \
    make -j8 && \
    make install && \
    ldconfig

RUN rm -rf /tmp/asn1c && \
    git clone https://github.com/mouse07410/asn1c /tmp/asn1c && \
    cd /tmp/asn1c && \
    git checkout 940dd5fa9f3917913fd487b13dfddfacd0ded06e && \
    git log -n1 && \
    autoreconf -iv && \
    ./configure --prefix /opt/asn1c/ && \
    make -j`nproc` && \
    make install

FROM oai-flexric-base AS oai-flexric-builder
ARG E2AP_VERSION=E2AP_V2
ARG KPM_VERSION=KPM_V2_03

WORKDIR /flexric
COPY ./flexric .

# Copy the NR RRC ASN.1 static library and headers from the RAN build
COPY --from=ran-build-source \
    /oai-ran/cmake_targets/ran_build/build/openair2/RRC/NR/MESSAGES/libasn1_nr_rrc.a \
    /tmp/ran_libs/

# Copy the generated NR RRC ASN.1 headers (needed for include paths)
COPY --from=ran-build-source \
    /oai-ran/cmake_targets/ran_build/build/openair2/RRC/NR/MESSAGES/ \
    /tmp/ran_headers/

# Also grab any ASN.1 runtime libraries from the RAN build
COPY --from=ran-build-source \
    /oai-ran/cmake_targets/ran_build/build/ \
    /tmp/ran_build/

RUN mkdir build && \
    cd build && \
    cmake -GNinja -DCMAKE_BUILD_TYPE=Release \
          -DE2AP_VERSION=$E2AP_VERSION \
          -DKPM_VERSION=$KPM_VERSION \
          -DCMAKE_C_COMPILER=gcc-12 \
          -DXAPP_MULTILANGUAGE=ON \
          -DCMAKE_CXX_COMPILER=g++-12 .. && \
    ninja && \
    ninja install && \
    # ============================================================
    # POST-BUILD FIX: Build a shared library from the RAN's NR RRC
    # ASN.1 static archive + ASN.1 runtime objects
    # ============================================================
    echo "=== Finding all archives with missing symbols ===" && \
    # Find archive with NR RRC symbols
    NR_RRC_LIB=$(find /tmp/ran_libs -name "libasn1_nr_rrc.a" | head -1) && \
    echo "NR RRC lib: $NR_RRC_LIB" && \
    # Find archive with ASN.1 runtime (uper_decode, asn_OP_CHOICE, etc.)
    ASN1_RT_LIB=$(find /tmp/ran_build -name "*.a" -exec sh -c \
      'nm "$1" 2>/dev/null | grep -q " T uper_decode$" && echo "$1"' _ {} \; | head -1) && \
    echo "ASN.1 runtime lib: $ASN1_RT_LIB" && \
    # Build a combined shared library from both
    gcc-12 -shared -fPIC -o /usr/local/lib/libnr_rrc_asn1_combined.so \
      -Wl,--whole-archive \
      "$NR_RRC_LIB" \
      ${ASN1_RT_LIB:+$ASN1_RT_LIB} \
      -Wl,--no-whole-archive \
      -lm -lpthread 2>&1 || \
    # Fallback: if ASN.1 runtime not found separately, try just NR RRC
    gcc-12 -shared -fPIC -o /usr/local/lib/libnr_rrc_asn1_combined.so \
      -Wl,--whole-archive \
      "$NR_RRC_LIB" \
      -Wl,--no-whole-archive \
      -lm -lpthread && \
    ldconfig && \
    echo "=== Verify symbols ===" && \
    nm -D /usr/local/lib/libnr_rrc_asn1_combined.so | grep "asn_DEF_NR_UL_DCCH_Message" && \
    echo "=== Check all previously undefined ASN.1 symbols ===" && \
    for sym in asn_DEF_NR_UL_DCCH_Message asn_OP_CHOICE uper_decode asn_DEF_BIT_STRING CHOICE_constraint; do \
      if nm -D /usr/local/lib/libnr_rrc_asn1_combined.so | grep -q " [TDB] $sym"; then \
        echo "  RESOLVED: $sym"; \
      else \
        echo "  MISSING:  $sym"; \
      fi; \
    done && \
    echo "SUCCESS: NR RRC ASN.1 shared library built" && \
    echo "--- Check shared objects dependencies for executable nearRT-RIC ---" && \
    ldd /flexric/build/examples/ric/nearRT-RIC && \
    echo "--- Check shared objects dependencies for xApp shared library ---" && \
    LD_PRELOAD=/usr/local/lib/libnr_rrc_asn1_combined.so \
    ldd /flexric/build/src/xApp/libe42_xapp_shared.so

#---------------------------------------------------------------------
# TARGET IMAGE
#---------------------------------------------------------------------
FROM $BASE_IMAGE AS oai-flexric
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Paris

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get upgrade --yes && \
    DEBIAN_FRONTEND=noninteractive apt-get install --yes \
       psmisc \
       gpg \
       wget \
       libsctp1 \
       python3 \
       python3-pip && \
    apt-get autoremove -y && \
    apt-get autoclean -y

WORKDIR /

# Copy the NR RRC ASN.1 combined shared library
COPY --from=oai-flexric-builder \
    /usr/local/lib/libnr_rrc_asn1_combined.so /usr/local/lib/

COPY --from=oai-flexric-builder \
    /usr/local/lib/flexric /usr/local/lib/flexric

COPY --from=oai-flexric-builder \
    /flexric/build/src/xApp/libe42_xapp_shared.so \
    /flexric/build/src/xApp/

COPY --from=oai-flexric-builder \
    /flexric/build/examples/ric/nearRT-RIC /usr/local/bin/nearRT-RIC

COPY --from=oai-flexric-builder \
    /flexric/build/examples/xApp /usr/local/flexric/xApp

COPY --from=oai-flexric-builder \
    /flexric/build/examples/emulator/agent /usr/local/flexric/emulator/agent

COPY --from=oai-flexric-builder \
    /flexric/build/28_552_kpm_meas.txt /flexric/build/28_552_kpm_meas.txt

# LD_PRELOAD ensures the NR RRC ASN.1 symbols are available
# when Python loads _xapp_sdk -> libe42_xapp_shared.so
ENV LD_PRELOAD=/usr/local/lib/libnr_rrc_asn1_combined.so

RUN ldconfig && \
    echo "--- Verify NR RRC ASN.1 symbols available ---" && \
    nm -D /usr/local/lib/libnr_rrc_asn1_combined.so | grep "asn_DEF_NR_UL_DCCH_Message" && \
    echo "--- Check nearRT-RIC ---" && \
    ldd /usr/local/bin/nearRT-RIC && \
    echo "--- Check xApp shared library ---" && \
    ldd /flexric/build/src/xApp/libe42_xapp_shared.so && \
    echo "--- Check flexric shared libraries ---" && \
    ldd /usr/local/lib/flexric/*.so

EXPOSE 36421/sctp
EXPOSE 36422/sctp

CMD ["stdbuf", "-o0", "nearRT-RIC"]
