# Base builder image
FROM ubuntu:jammy AS builder-base
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Paris

# Install build dependencies in a single layer
RUN apt-get update && \
    apt-get upgrade --yes && \
    apt-get install -y --fix-missing \
        apt-utils \
        psmisc \
        libsctp1 \
        python3 \
        python3-pip \
        build-essential \
        libsctp-dev \
        gpg \
        git \
        wget \
        tar \
        m4 \
        automake \
        libtool \
        cmake \
        cmake-curses-gui \
        ninja-build \
        bison \
        flex \
        gdb \
        libpcre2-dev \
        software-properties-common \
        python3.10-dev && \
    apt-get clean

RUN add-apt-repository -y ppa:ubuntu-toolchain-r/test && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential \
        ninja-build \
        gcc-13 \
        g++-13 \
        mold && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN git clone -b release-4.1 https://github.com/swig/swig.git && \
    cd swig && \
    ./autogen.sh && \
    ./configure --prefix=/usr/ && \
    make -j8 && \
    make install

RUN rm -rf /tmp/asn1c && \
    git clone https://github.com/mouse07410/asn1c /tmp/asn1c && \
    cd /tmp/asn1c && \
    git checkout 940dd5fa9f3917913fd487b13dfddfacd0ded06e && \
    git log -n1 && \
    autoreconf -iv && \
    ./configure --prefix=/opt/asn1c/ && \
    make -j8 && \
    make install

# FlexRIC builder stage
FROM builder-base AS flexric-builder
ARG E2AP_VERSION=E2AP_V3
ARG KPM_VERSION=KPM_V3_00

# # Copy from previous stages
# COPY --from=swig-builder /usr/bin/swig /usr/bin/
# COPY --from=swig-builder /usr/share/swig /usr/share/swig
# COPY --from=asn1c-builder /opt/asn1c /opt/asn1c

ENV PATH="/opt/asn1c/bin:${PATH}"

# Build FlexRIC
WORKDIR /flexric
COPY ./flexric .

# KEY FIX: Use Makefiles instead of Ninja, and add --whole-archive linker flag
RUN mkdir build && \
    cd build && \
    cmake -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_ASN1C_EXECUTABLE=/opt/asn1c/bin/asn1c \
          -DE2AP_VERSION=$E2AP_VERSION \
          -DKPM_VERSION=$KPM_VERSION \
          -DXAPP_MULTILANGUAGE=ON \
          -DCMAKE_INSTALL_PREFIX=/usr/local \
          -DCMAKE_C_FLAGS_RELEASE="-O3" \
          -DCMAKE_CXX_FLAGS_RELEASE="-O3" \
          -DCMAKE_SHARED_LINKER_FLAGS="-Wl,--no-as-needed" \
          -DCMAKE_C_COMPILER=gcc-13 \
          -DCMAKE_CXX_COMPILER=g++-13 .. && \
    make -j$(nproc) VERBOSE=1 && \
    make install && \
    echo "=== Verify xApp shared library symbols ===" && \
    nm -D /flexric/build/src/xApp/libe42_xapp_shared.so | grep "asn_DEF_NR_UL_DCCH_Message" && \
    echo "=== Check shared object dependencies ===" && \
    ldd /flexric/build/src/xApp/libe42_xapp_shared.so && \
    echo "=== List all built .so files ===" && \
    find /flexric/build -name "*.so*" -exec ls -la {} \;

# Final runtime image
FROM ubuntu:jammy
ENV DEBIAN_FRONTEND=noninteractive
ENV TZ=Europe/Paris
ENV XAPP_DURATION=-1

# Install runtime dependencies
RUN apt-get update && \
    apt-get install -y software-properties-common && \
    add-apt-repository -y ppa:ubuntu-toolchain-r/test && \
    apt-get update && \
    apt-get install -y --no-install-recommends \
        libsctp1 \
        python3.10 \
        libpcre2-8-0 \
        net-tools \
        iproute2 \
        libssl3 \
        libstdc++6 && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Copy ALL shared libraries from the build
COPY --from=flexric-builder /usr/local/lib/flexric/ /usr/local/lib/flexric/
COPY --from=flexric-builder /flexric/build/src/xApp/libe42_xapp_shared.so /flexric/build/src/xApp/

# Copy ALL .so files from the build tree (catches ASN.1 libs)
COPY --from=flexric-builder /flexric/build/src/ /flexric/build/src/

COPY --from=flexric-builder /flexric/build/examples/xApp /usr/local/flexric/xApp
COPY --from=flexric-builder /flexric/build/examples/ric/nearRT-RIC /usr/local/bin/nearRT-RIC
COPY --from=flexric-builder /flexric/build/examples/emulator/agent /usr/local/flexric/emulator/agent
COPY --from=flexric-builder /flexric/build/28_552_kpm_meas.txt /flexric/build/28_552_kpm_meas.txt

# Register ALL library paths
RUN echo "/flexric/build/src/xApp" > /etc/ld.so.conf.d/flexric.conf && \
    echo "/flexric/build/src/sm" >> /etc/ld.so.conf.d/flexric.conf && \
    echo "/flexric/build/src/lib" >> /etc/ld.so.conf.d/flexric.conf && \
    echo "/usr/local/lib/flexric" >> /etc/ld.so.conf.d/flexric.conf && \
    find /flexric/build -name "*.so*" -exec dirname {} \; | sort -u >> /etc/ld.so.conf.d/flexric.conf && \
    ldconfig && \
    echo "--- Check shared objects dependencies for executable nearRT-RIC ---" && \
    ldd /usr/local/bin/nearRT-RIC && \
    echo "=== Verify xApp SDK loads ===" && \
    ldd /flexric/build/src/xApp/libe42_xapp_shared.so && \
    echo "--- Check shared objects dependencies for flexric shared libraries ---" && \
    ldd /usr/local/lib/flexric/*.so* && \
    echo "=== All flexric .so files ===" && \
    find /flexric /usr/local/lib/flexric -name "*.so*" -exec ls -la {} \;

# Copy config files
COPY ./volumes/flexric_*.conf /usr/local/etc/flexric/
COPY ./volumes/ric.conf /usr/local/etc/flexric/
COPY ./volumes/ric.conf /usr/local/etc/flexric/flexric.conf

EXPOSE 36421/sctp 36422/sctp

WORKDIR /flexric
CMD ["/bin/bash", "-c", "sleep infinity"]
