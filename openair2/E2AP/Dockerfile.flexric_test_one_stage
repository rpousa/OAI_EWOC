#     /usr/local/lib/flexric/libslice_sm.so \
#     /usr/local/lib/flexric/libtc_sm.so \
#     /usr/local/lib/flexric/libgtp_sm.so \
#     /usr/local/lib/flexric/libpdcp_sm.so \
#     /usr/local/lib/flexric/librc_sm.so \
#     /usr/local/lib/flexric/

# COPY --from=oai-flexric-builder \
#     /flexric/build/src/xApp/libe42_xapp_shared.so \
#     /flexric/build/src/xApp/

# COPY --from=oai-flexric-builder \
#     /flexric/build/examples/ric/nearRT-RIC /usr/local/bin/nearRT-RIC

# ## Copy xApps
# COPY --from=oai-flexric-builder \
#     /flexric/build/examples/xApp /usr/local/flexric/xApp

## E2
EXPOSE 36421/sctp
## E42
EXPOSE 36422/sctp

COPY ./volumes/flexric_gnb.conf /usr/local/etc/flexric/flexric_gnb.conf
COPY ./volumes/flexric_cu.conf /usr/local/etc/flexric/flexric_cu.conf
COPY ./volumes/flexric_du.conf /usr/local/etc/flexric/flexric_du.conf
COPY ./volumes/flexric_cucp.conf /usr/local/etc/flexric/flexric_cucp.conf
COPY ./volumes/flexric_cuup.conf /usr/local/etc/flexric/flexric_cuup.conf
COPY ./volumes/ric.conf /usr/local/etc/flexric/ric.conf
COPY ./volumes/ric.conf /usr/local/etc/flexric/flexric.conf

RUN echo "--- Check shared objects dependencies for flexric shared libraries ---" && \
    ls /usr/local/lib/flexric/ && \
    ldd /usr/local/lib/flexric/*.so 

WORKDIR /flexric/build

ENTRYPOINT [""]
#CMD ["/bin/bash"]
CMD ["/bin/bash", "-c", "sleep infinity"]
