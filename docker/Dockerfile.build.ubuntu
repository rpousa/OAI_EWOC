#---------------------------------------------------------------------
#
# Dockerfile for the Open-Air-Interface BUILD service
#   Valid for Ubuntu 24.04
#
#---------------------------------------------------------------------

FROM ran-base:latest AS ran-build
ARG BUILD_OPTION

ARG E2AP_VERSION=E2AP_V3
ARG KPM_VERSION=KPM_V3_00

# Build OAI's own E2 agent into the softmodem and nr-cuup binaries.  The agent
# links against the in-tree FlexRIC submodule (openair2/E2AP/flexric), which the
# second RUN block below builds and installs regardless of this setting -- the
# service-model .so files land in /usr/local/lib/flexric either way, and the leaf
# images copy them.  So E2_AGENT=OFF yields binaries that cannot register with a
# RIC while still shipping the SM libraries, which is a confusing half state.
# ON is the default because the inter-CU-UP relocation test bed drives the
# handover from an xApp and needs the CU-CP, both CU-UPs and the DU to appear as
# E2 nodes.  Pass OFF only to bisect a FlexRIC-vs-tree compile failure.
ARG E2_AGENT=ON

RUN rm -Rf /oai-ran
WORKDIR /oai-ran
COPY . .

# build all targets so final targets can be created afterwards
RUN \
   # Mount CCache cache direrctory
   --mount=type=cache,target=/root/.cache/ccache/ \
   # Mount CPM package cache
   --mount=type=cache,target=/root/.cache/cpm/ \
    /bin/sh oaienv && \
    cd cmake_targets && \
    mkdir -p log && \
    ./build_oai -c --ninja \
      --eNB --gNB --RU --UE --nrUE \
      --build-lib "telnetsrv enbscope uescope nrscope" \
      -w USRP -t Ethernet -w BLADERF \
      --build-e2 --cmake-opt -DE2_AGENT=$E2_AGENT \
      --cmake-opt -DKPM_VERSION=$KPM_VERSION --cmake-opt -DE2AP_VERSION=$E2AP_VERSION \
      --cmake-opt -DOAI_VRTSIM_TAPS_CLIENT=ON \
      --noavx512 \
      --build-tool-opt -k10 \
      --cmake-opt -DT_RECORD_DB=ON \
      --cmake-opt -DCMAKE_C_FLAGS="-Werror" --cmake-opt -DCMAKE_CXX_FLAGS="-Werror" $BUILD_OPTION && \
    # Mainly to see if the sanitize option was perfectly executed
    echo "---- ldd on executables ----" && \
    ldd ran_build/build/*softmodem* ran_build/build/nr-cuup ran_build/build/oairu && \
    echo "---- ldd on shared libraries ----" && \
    ldd ran_build/build/*.so

## Build FlexRIC for SM Models
RUN \
    # Mount CCache cache direrctory
    --mount=type=cache,target=/root/.cache/ccache/ \
    mkdir -p openair2/E2AP/flexric/build && \
    cd openair2/E2AP/flexric/build && \
    cmake -GNinja -DCMAKE_BUILD_TYPE=Release \
          -DKPM_VERSION=$KPM_VERSION \
          -DE2AP_VERSION=$E2AP_VERSION .. && \
    ninja && \
    ninja install
